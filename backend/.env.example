# Application Settings
APP_NAME="Gaming Media Discovery API"
APP_ENV=development
API_PREFIX=/api
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Database
# Format: postgresql+psycopg://user:password@host:port/dbname
# Do not commit real passwords to version control
DATABASE_URL=postgresql+psycopg://postgres:placeholder@localhost:5432/gaming_media

# External Providers
SEARCH_PROVIDER=mock
# BRAVE_SEARCH_API_KEY=your_brave_api_key_here
TRAFFIC_PROVIDER=mock

# Search Discovery Constraints
SEARCH_RESULTS_PER_QUERY=10
MAX_SEARCH_QUERIES=20
SEARCH_REQUEST_TIMEOUT_SECONDS=10
MAX_SEARCH_CONCURRENCY=3
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search
# BRAVE_SEARCH_SAFESEARCH=moderate
# BRAVE_SEARCH_FRESHNESS=
# BRAVE_SEARCH_MAX_RETRIES=2

# Traffic Provider
TRAFFIC_PROVIDER=mock

# Fetching Settings
MAX_FETCH_CONCURRENCY=5
MAX_FETCHES_PER_HOST=2
FETCH_DNS_TIMEOUT_SECONDS=3
FETCH_CONNECT_TIMEOUT_SECONDS=5
FETCH_READ_TIMEOUT_SECONDS=10
FETCH_WRITE_TIMEOUT_SECONDS=5
FETCH_POOL_TIMEOUT_SECONDS=5
FETCH_TOTAL_TIMEOUT_SECONDS=20
MAX_FETCH_REDIRECTS=5
MAX_HTML_RESPONSE_BYTES=2097152
FETCH_PREVIEW_MAX_CHARS=5000
MAX_FETCH_CANDIDATES=50
FETCH_MAX_RETRIES=2
FETCH_RETRY_BASE_DELAY_SECONDS=0.5
FETCH_MAX_RETRY_DELAY_SECONDS=3.0
FETCH_USER_AGENT="GamingMediaDiscoveryBot/0.1 (+local research tool)"
# Verification Limits
MAX_VERIFICATION_CANDIDATES=50
MAX_VERIFICATION_CONCURRENCY=4
VERIFICATION_TIMEOUT_SECONDS=5

MAX_VERIFICATION_HTML_CHARS=2000000
MAX_ANALYZED_ANCHORS=500
MAX_ANALYZED_HEADINGS=100
MAX_ANALYZED_NAV_ITEMS=150
MAX_ANALYZED_TIME_ELEMENTS=100
MAX_ANALYZED_JSONLD_BLOCKS=20
MAX_JSONLD_BLOCK_CHARS=50000
MAX_JSONLD_DEPTH=10
MAX_EXTRACTED_TEXT_CHARS=50000
MAX_ELEMENT_TEXT_CHARS=500
MAX_REASON_EVIDENCE_CHARS=300
MAX_REASONS_PER_GROUP=20


# Qualification Thresholds
GAMING_MEDIA_VERIFIED_THRESHOLD=70
GAMING_MEDIA_UNCERTAIN_THRESHOLD=40
DEFAULT_MINIMUM_PAGEVIEWS=1000000
